{
	"name": "t3monitor/t3monitoring_client",
	"type": "typo3-cms-extension",
	"description": "Client extension for the t3monitoring service",
	"license": [
		"GPL-2.0-or-later"
	],
	"require": {
		"php": "^8.2",
		"ext-mbstring": "*",
		"typo3/cms-core": "^12 || ^13 || ^14",
		"typo3/cms-extensionmanager": "^12 || ^13 || ^14",
		"typo3/cms-install": "^12 || ^13 || ^14",
		"typo3/cms-reports": "^12 || ^13 || ^14"
	},
	"require-dev": {
		"typo3/minimal": "^12 || ^13 || ^14",
		"typo3/testing-framework": "^8",
		"typo3/coding-standards": "^v0.8.0",
		"friendsofphp/php-cs-fixer": "^3.13.0"
	},
	"config": {
		"lock": false,
		"vendor-dir": ".Build/vendor",
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	},
	"autoload": {
		"psr-4": {
			"T3Monitor\\T3monitoringClient\\": "Classes"
		}
	},
	"scripts": {
		"cs": "php ./.Build/vendor/bin/php-cs-fixer fix  --dry-run -v --config ./Build/php-cs-fixer/php-cs-fixer.php ./",
		"csfix": "php ./.Build/vendor/bin/php-cs-fixer fix  -v --config ./Build/php-cs-fixer/php-cs-fixer.php ./"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "11.x-dev"
		},
		"typo3/cms": {
			"extension-key": "t3monitoring_client",
			"web-dir": ".Build/web"
		}
	}
}
